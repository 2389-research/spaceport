<?xml version="1.0" encoding="utf-8"?>
<!-- ABOUTME: Displays agent counts and the cache timestamp without terminal titles or host names. -->
<!-- ABOUTME: Offers two touch targets that open the foreground app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/widget_background" android:padding="12dp">
    <TextView android:id="@+id/widget_waiting" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#ffffff"/>
    <TextView android:id="@+id/widget_counts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#dfdce5" android:textSize="14sp"/>
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#dfdce5" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_resume" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/widget_resume" android:textColor="#adccff"/>
        <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/widget_next" android:textColor="#adccff"/>
    </LinearLayout>
</LinearLayout>
