#!/bin/bash
# ABOUTME: Builds the Android client and its native controller through the Gradle wrapper.
# ABOUTME: Prints the local debug APK path for installation on a device or emulator.
set -euo pipefail
cd "$(dirname "$0")/android"
if [[ -z "${ANDROID_HOME:-}${ANDROID_SDK_ROOT:-}" && ! -f local.properties ]]; then
    for sdk in "$HOME/Library/Android/sdk" "$HOME/Android/Sdk"; do
        if [[ -d "$sdk" ]]; then
            export ANDROID_HOME="$sdk"
            break
        fi
    done
fi
case "${1:-}" in
    "") task=assembleDebug ;;
    --release) task=assembleRelease ;;
    *) echo "usage: $0 [--release]" >&2; exit 2 ;;
esac
./gradlew ":app:$task"
if [[ "$task" == assembleDebug ]]; then
    echo "$PWD/app/build/outputs/apk/debug/app-debug.apk"
fi
