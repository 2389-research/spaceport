<?xml version="1.0" encoding="UTF-8"?>
<!-- ABOUTME: Registers the agent status Home Screen widget and Live Activity with WidgetKit. -->
<!-- ABOUTME: Xcode supplies the extension identifier and version. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>SpaceportWidgetGroup</key>
    <string>$(SPACEPORT_WIDGET_GROUP)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.widgetkit-extension</string>
    </dict>
</dict>
</plist>
