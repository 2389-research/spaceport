# A connection's state, as the main window's status line reports it.

# The daemon answered a request to show a terminal surface with a reply the
# app could not read.
state-activation-invalid = Invalid surface activation acknowledgement

# The connection's SSH bridge does not check the host's key, so anyone able to
# intercept the connection can impersonate the host. Shown on every connection
# to a host listed under `[ssh] skip_host_key_verification`.
state-host-key-unverified = Host key not verified, so anyone intercepting this connection can impersonate the host
