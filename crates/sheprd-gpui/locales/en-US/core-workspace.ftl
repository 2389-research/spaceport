# Spaceport groups in Core's watched presentation document.
core-workspace-section = Core groups
core-workspace-new = New
core-workspace-empty = No Core groups yet
core-workspace-more = { $count } more Core groups
core-workspace-connect = Connect to Core to load groups
core-workspace-join-error = Could not connect to Core: { $reason }
core-workspace-loading = Loading Core groups…
core-workspace-error = Could not load Core groups: { $reason }
core-workspace-stale = Core groups are not current. Wait for a refresh before creating one.
core-workspace-unknown = Core did not confirm the edit ({ $reason }). Wait for a new document version before creating another group.
core-workspace-uncertain = An earlier edit is still unconfirmed. Wait for a new document version before creating another group.
core-workspace-creating = Creating Core group…
core-workspace-worker-error = Could not start Core group edit: { $reason }
core-workspace-worker-lost = Core did not confirm the edit. Wait for a new document version before creating another group.
