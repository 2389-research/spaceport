# The open worktree picker.
worktree-open-search = Search worktrees...
worktree-open-count = { $total ->
        [one] { $shown } of { $total } worktree
       *[other] { $shown } of { $total } worktrees
    }
# Beside a checkout a Herdr workspace already has open.
worktree-open-open = open
worktree-open-detached = detached
worktree-open-loading = Loading worktrees...
worktree-open-no-matching = No matching worktrees. Try a shorter search.
worktree-open-unavailable = Worktrees unavailable.
worktree-open-empty = No Git worktrees found for this repository.
