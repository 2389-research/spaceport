# Failures sending an image from the clipboard to a pane through the daemon.

error-client-clipboard-busy = Another clipboard paste is in progress. Wait for it to finish.
error-client-clipboard-cancelled = clipboard image upload cancelled
error-client-clipboard-input-target = This terminal connection cannot paste this clipboard content.
error-client-clipboard-preparation-timeout = Preparing the clipboard content took too long. It was not pasted. Try pasting again.
error-client-clipboard-write-timeout = Spaceport could not finish sending clipboard input. Some input may have arrived. Choose Terminal → Reconnect.
